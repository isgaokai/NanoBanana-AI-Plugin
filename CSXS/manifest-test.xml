<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ExtensionBundleId="com.test.minimal" ExtensionBundleVersion="1.0.0" Version="7.0">
    <ExtensionList>
        <Extension Id="com.test.minimal.panel" Version="1.0.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHSP" Version="[14.0,99.9]"/>
            <Host Name="PHXS" Version="[14.0,99.9]"/>
        </HostList>
        <LocaleList><Locale Code="All"/></LocaleList>
        <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="7.0"/></RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.test.minimal.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./test-minimal.html</MainPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--disable-web-security</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Minimal Test</Menu>
                    <Geometry>
                        <Size><Height>400</Height><Width>500</Width></Size>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
